# Typst Demo

```elixir
Mix.install([
  {:wasmex, "~> 0.16.1"},
  {:kino, "~> 0.18.0"},
])
```

## Define Typst Genserver

```elixir
defmodule Typst do
  use GenServer

  def init(init_arg) do
    {:ok, init_arg}
  end

  @base_file_path Path.join(__DIR__, "demo")

  def resolve_file(:none, vpath) do
    dbg("resolve single file: #{vpath}")
    path = Path.join(@base_file_path, vpath)

    if File.exists?(path) do
      bytes = path |> File.read!() |> :binary.bin_to_list()
      {:ok, bytes}
    else
      {:error, {:'not-found', "NOT FOUND - #{vpath}"}}
    end
  end

  # assumes packages are stored in demo/preview/package_name-version
  # for example demo/preview/invoice-maker-0.1.0
  # we _could_ implement automatic downloads if we wanted, the package manager url follows this schema:
  # https://packages.typst.org/preview/invoice-maker-1.1.0.tar.gz
  # we careful, though, of automatic downloads in production if packages are user-provided.
  def resolve_file({:some, %{namespace: namespace, name: name, version: %{major: major, minor: minor, patch: patch}}}, vpath) do
    dbg("resolve package: %{namespace: #{namespace}, name: #{name}, version: #{major}.#{minor}.#{patch}} - #{vpath}")

    subpath = Path.join([namespace, "#{name}-#{major}.#{minor}.#{patch}", vpath])
    path = Path.join(@base_file_path, subpath)

    if File.exists?(path) do
      bytes = path |> File.read!() |> :binary.bin_to_list()
      {:ok, bytes}
    else
      {:error, {:'not-found', "NOT FOUND - #{subpath}"}}
    end
  end

  def start_link() do
    [
      path: Kino.FS.file_path("typst_wasm_component.wasm"),
      wasi: %Wasmex.Wasi.WasiP2Options{},
      imports: %{
        "resolve-file" =>
          {:fn,
           fn spec, vpath ->
             dbg({spec, vpath})
             resolve_file(spec, vpath)
           end}
      }
    ]
    |> Wasmex.Components.start_link()
  end

  def handle_call(request, from, state) do
    Wasmex.Components.handle_call(request, from, state)
  end

  # ----

  def compile_template(pid, template, fonts) do
    render_options = %{
      template: template,
      fonts: fonts
    }

    {:ok, result} = Wasmex.Components.call_function(pid, :"compile-template", [render_options], 10_000)
    result
  end

  def free_template(pid, template_handle) do
    {:ok, freed?} = Wasmex.Components.call_function(pid, :"free-template", [template_handle])
    freed?
  end

  def render_pdf(pid, template_handle, data) do
    data_json = JSON.encode!(data)
    {:ok, result} = Wasmex.Components.call_function(pid, :"render-pdf", [template_handle, data_json], 99_000)
    result
  end
end

```

```elixir
{:ok, pid} = Typst.start_link()
{:ok, current_template} = Agent.start_link(fn -> nil end)
```

## Define Typst Template and Data

```elixir
default_document = """
#import sys: inputs

#set text(
  font: "Open Sans"
)

#show math.equation: set text(font: "Fira Math")

= #inputs.title
In this report, we will explore the
various factors that influence _fluid
dynamics_ in glaciers and how they
contribute to the formation and
behaviour of these natural structures.

+ The climate
  - Temperature
  - Precipitation
+ The topography
+ The geology

Glaciers as the one shown in
@glaciers will cease to exist if
we don't take action soon!

#figure(
  image("glacier.jpg", width: 70%),
  caption: [
    _Glaciers_ form an important part
    of the earth's climate system.
  ],
) <glaciers>

The flow rate of a glacier is
defined by the following equation:

$ Q = rho A v + C $

Total displaced soil by glacial flow:

$ 7.32 beta +
  sum_(i=0)^nabla
    (Q_i (a_i - epsilon)) / 2 $
"""

default_invoice = """
#import "@preview/invoice-maker:1.1.0": *

#import sys: inputs

#show: invoice.with(
  language: "en",
  banner-image: image("signature.png"),
  invoice-id: "2025-12-16t183205",
  biller: inputs.biller,
  hourly-rate: 100,
  recipient: inputs.recipient,
  items: inputs.items,
  styling: ( font: "Open Sans" ),
)
"""

# template_cell = Kino.Input.textarea("Template", default: default_document)
template_cell = Kino.Input.textarea("Template", default: default_invoice)
```

```elixir
template = Kino.Input.read(template_cell)

opens_sans = Kino.FS.file_path("OpenSans-Regular.ttf") |> File.read!() |> :binary.bin_to_list()
fira_math = Kino.FS.file_path("FiraMath-Regular.otf") |> File.read!() |> :binary.bin_to_list()
{:ok, handle} =
  Agent.get_and_update(current_template, fn previous_handle ->
    case Typst.compile_template(pid, template, [opens_sans, fira_math]) do
      {:ok, new_handle} = result ->
        if previous_handle != nil do
          Typst.free_template(pid, previous_handle)
        end

        {result, new_handle}

      {:error, _reason} = error ->
        {error, previous_handle}
    end
  end, 15_000)
```

